ENVIRONMENT=production
DEPLOYMENT_MODE=telegram
DATABASE_URL*=postgresql+psycopg://platform_api:REEMPLAZAR@HOST_NEON_POOLER/neondb?sslmode=require&channel_binding=require
SYSTEM_DATABASE_URL*=postgresql+psycopg://neondb_owner:REEMPLAZAR@HOST_NEON_POOLER/neondb?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL*=postgresql+psycopg://neondb_owner:REEMPLAZAR@HOST_NEON_DIRECTO/neondb?sslmode=require&channel_binding=require
MASTER_BOT_TOKEN*=REEMPLAZAR_TOKEN_NUEVO_MASTER
MASTER_BOT_USERNAME=REEMPLAZAR_USUARIO_NUEVO_MASTER
PLATFORM_OWNER_IDS=REEMPLAZAR_ID_NUMERICO_TELEGRAM
ENCRYPTION_KEYS*={"v1":"REEMPLAZAR_BASE64_32_BYTES"}
ACTIVE_KEY_VERSION=v1
RECEIPT_STORAGE=database
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=5242880
POLLING_TIMEOUT=25
MAINTENANCE_INTERVAL=900
POLLING_MAX_BOTS=20
TRIAL_DAYS=3
WORKER_LEASE_SECONDS=180
BOT_RPS=20
TENANT_RPS=30
GLOBAL_RPS=300
USER_RPS=1
DEMO_ENABLED=false
TELEGRAM_TEST_ENVIRONMENT=false

BILLING_GRACE_DAYS=3
INTERACTIVE_WORKERS=2
BACKGROUND_WORKERS=2
TELEGRAM_TRANSPORT=polling
PAYMENT_WEBHOOKS_ENABLED=false
