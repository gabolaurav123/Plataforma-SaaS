ENVIRONMENT=production
DATABASE_URL*=postgresql+psycopg://platform_api:REEMPLAZAR@HOST_NEON/BASE?sslmode=require&channel_binding=require
SYSTEM_DATABASE_URL*=postgresql+psycopg://neondb_owner:REEMPLAZAR@HOST_NEON/BASE?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL*=postgresql+psycopg://neondb_owner:REEMPLAZAR@HOST_DIRECTO_NEON/BASE?sslmode=require&channel_binding=require
REDIS_URL*=redis://:REEMPLAZAR@HOST_PRIVADO_REDIS:6379/0
MASTER_BOT_TOKEN*=REEMPLAZAR_TOKEN_NUEVO_MASTER
MASTER_BOT_USERNAME=REEMPLAZAR_USUARIO_NUEVO_MASTER
MASTER_WEBHOOK_SECRET*=REEMPLAZAR_SECRETO_ALEATORIO_64_HEXADECIMALES
PLATFORM_OWNER_IDS=REEMPLAZAR_ID_NUMERICO_TELEGRAM
ENCRYPTION_KEYS*={"v1":"REEMPLAZAR_BASE64_32_BYTES"}
ACTIVE_KEY_VERSION=v1
PUBLIC_API_URL=https://REEMPLAZAR_URL_API
MINI_APP_URL=https://REEMPLAZAR_URL_MINI_APP
ALLOWED_ORIGINS=https://REEMPLAZAR_URL_MINI_APP
RECEIPT_STORAGE=database
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=5242880
DEMO_ENABLED=false
TELEGRAM_TEST_ENVIRONMENT=false
SESSION_TTL_SECONDS=1800
INIT_DATA_MAX_AGE_SECONDS=300
TRIAL_DAYS=7
WORKER_LEASE_SECONDS=180
JOBS_PER_TENANT_ROUND=5
BOT_RPS=20
TENANT_RPS=30
GLOBAL_RPS=300
USER_RPS=1
