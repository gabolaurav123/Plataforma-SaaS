# Para Seenode usar deploy/seenode/worker.env.example.
DEPLOYMENT_MODE=telegram
POLLING_TIMEOUT=25
MAINTENANCE_INTERVAL=900
POLLING_MAX_BOTS=20
ENVIRONMENT=development
DATABASE_URL=sqlite:///./platform.db
# Docker only: generate two distinct passwords (hex avoids URL-escaping errors).
POSTGRES_PASSWORD=
PLATFORM_API_PASSWORD=
# Production API role: postgresql+psycopg://platform_api:...@db:5432/creator_platform
# Privileged backend-only role for authenticated bootstrap/webhooks/workers.
SYSTEM_DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
MASTER_BOT_TOKEN=
MASTER_WEBHOOK_SECRET=
MASTER_BOT_USERNAME=
PLATFORM_OWNER_IDS=
# JSON map of base64 32-byte keys. Generate with scripts/bootstrap.py for local use.
ENCRYPTION_KEYS={}
ACTIVE_KEY_VERSION=v1
PUBLIC_API_URL=http://localhost:8000
MINI_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=1800
INIT_DATA_MAX_AGE_SECONDS=300
TRIAL_DAYS=3
STORAGE_PATH=./storage
RECEIPT_STORAGE=filesystem
MAX_UPLOAD_BYTES=5242880
TELEGRAM_TEST_ENVIRONMENT=false
DEMO_ENABLED=false
WORKER_LEASE_SECONDS=180
BOT_RPS=20
TENANT_RPS=30
GLOBAL_RPS=300
USER_RPS=1
